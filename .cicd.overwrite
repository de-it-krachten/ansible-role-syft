---

# Generic
generic:
  role: ansible-role-syft
  role_short: syft
  role_description: |
    Installs syft, CLI tool and library for generating a Software Bill of Materials from container images and filesystems<br>
    https://github.com/anchore/syft<br>
  collections: []

# Supported platforms
platforms:
  sles15:
    supported: true
    ci: false
  sles16:
    supported: true
    ci: false
  opensuse15:
    supported: true
    ci: true
  opensuse16:
    supported: true
    ci: true
  ubuntu2004:
    supported: true
    ci: true

# Dependencies
dependencies:
  roles:
    - deitkrachten.cron
    - deitkrachten.logrotate
  collections: []

# Molecule
molecule:
  requirements:
    roles_extra:
      - deitkrachten.cron
      - deitkrachten.logrotate
  converge:
    roles:
      - deitkrachten.cron
      - deitkrachten.logrotate
    vars:
      syft_schedule: true
      syft_immediate: true
      syft_central_path: /tmp/syft
